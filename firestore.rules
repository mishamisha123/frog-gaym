rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validUsername(name) {
      return name is string
        && name.size() >= 3
        && name.size() <= 16
        && name.matches('^[A-Za-z0-9_]+$');
    }

    function validProfile(uid) {
      return request.resource.data.keys().hasOnly([
          'username', 'usernameLower', 'createdAt', 'updatedAt', 'schemaVersion'
        ])
        && validUsername(request.resource.data.username)
        && request.resource.data.usernameLower == request.resource.data.username.lower()
        && request.resource.data.schemaVersion == 1
        && getAfter(
          /databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)
        ).data.uid == uid
        && getAfter(
          /databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)
        ).data.username == request.resource.data.username;
    }

    function requestParticipant(data) {
      return signedIn()
        && (request.auth.uid == data.fromUid || request.auth.uid == data.toUid);
    }

    function validFriendRequestCreate(requestId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'fromUid', 'toUid', 'participants', 'fromUsername', 'toUsername',
          'status', 'createdAt', 'schemaVersion'
        ])
        && request.auth.uid == data.fromUid
        && data.fromUid != data.toUid
        && data.participants is list
        && data.participants.size() == 2
        && data.participants[0] == data.fromUid
        && data.participants[1] == data.toUid
        && requestId == data.fromUid + '__' + data.toUid
        && data.status == 'pending'
        && data.schemaVersion == 2
        && data.createdAt == request.time
        && exists(/databases/$(database)/documents/profiles/$(data.fromUid))
        && exists(/databases/$(database)/documents/profiles/$(data.toUid))
        && data.fromUsername == get(/databases/$(database)/documents/profiles/$(data.fromUid)).data.username
        && data.toUsername == get(/databases/$(database)/documents/profiles/$(data.toUid)).data.username
        && !exists(/databases/$(database)/documents/friendRequests/$(data.toUid + '__' + data.fromUid))
        && !exists(/databases/$(database)/documents/friendships/$(requestId))
        && !exists(/databases/$(database)/documents/friendships/$(data.toUid + '__' + data.fromUid));
    }

    function validFriendshipCreate(friendshipId) {
      let data = request.resource.data;
      let friendRequest = getAfter(
        /databases/$(database)/documents/friendRequests/$(friendshipId)
      ).data;
      return data.keys().hasOnly([
          'requestId', 'members', 'fromUid', 'toUid', 'fromUsername',
          'toUsername', 'createdAt', 'schemaVersion'
        ])
        && data.requestId == friendshipId
        && data.members is list
        && data.members.size() == 2
        && data.members[0] == data.fromUid
        && data.members[1] == data.toUid
        && data.fromUid != data.toUid
        && request.auth.uid in data.members
        && data.schemaVersion == 1
        && data.createdAt == request.time
        && friendRequest.status == 'accepted'
        && friendRequest.fromUid == data.fromUid
        && friendRequest.toUid == data.toUid
        && friendRequest.fromUsername == data.fromUsername
        && friendRequest.toUsername == data.toUsername;
    }

    function validGameSave() {
      return request.resource.data.keys().hasOnly([
          'save',
          'saveRevision',
          'updatedAt',
          'schemaVersion',
          'gameVersion',
          'deviceId'
        ])
        && request.resource.data.save is map
        && request.resource.data.saveRevision is int
        && request.resource.data.saveRevision >= 1
        && request.resource.data.updatedAt == request.time
        && request.resource.data.schemaVersion == 1
        && request.resource.data.gameVersion is string
        && request.resource.data.gameVersion.size() <= 24
        && request.resource.data.deviceId is string
        && request.resource.data.deviceId.size() >= 1
        && request.resource.data.deviceId.size() <= 80;
    }

    match /profiles/{uid} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == uid
        && !exists(/databases/$(database)/documents/profiles/$(uid))
        && validProfile(uid);
      allow update, delete: if false;
    }

    match /usernames/{handle} {
      allow read: if signedIn();
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/usernames/$(handle))
        && request.resource.data.keys().hasOnly(['uid', 'username', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && validUsername(request.resource.data.username)
        && handle == request.resource.data.username.lower()
        && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.usernameLower == handle
        && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.username == request.resource.data.username;
      allow update, delete: if false;
    }

    match /friendRequests/{requestId} {
      // List queries must use where('participants', 'array-contains', request.auth.uid).
      // This aligns the query with the rule, so Firestore can prove every result is private to the player.
      allow read: if signedIn()
        && resource.data.participants is list
        && request.auth.uid in resource.data.participants;
      allow create: if signedIn() && validFriendRequestCreate(requestId);
      allow update: if signedIn()
        && request.auth.uid == resource.data.toUid
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
        && request.resource.data.status == 'accepted'
        && request.resource.data.respondedAt == request.time
        && existsAfter(/databases/$(database)/documents/friendships/$(requestId));
      allow delete: if signedIn()
        && resource.data.participants is list
        && request.auth.uid in resource.data.participants
        && !existsAfter(/databases/$(database)/documents/friendships/$(requestId));
    }

    match /friendships/{friendshipId} {
      allow read: if signedIn()
        && resource.data.members is list
        && request.auth.uid in resource.data.members;
      allow create: if signedIn() && validFriendshipCreate(friendshipId);
      allow update: if false;
      allow delete: if signedIn()
        && request.auth.uid in resource.data.members
        && !existsAfter(/databases/$(database)/documents/friendRequests/$(friendshipId));
    }

    match /gameSaves/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && request.auth.uid == uid
        && !exists(/databases/$(database)/documents/gameSaves/$(uid))
        && validGameSave();
      allow update: if signedIn()
        && request.auth.uid == uid
        && validGameSave()
        && request.resource.data.saveRevision == resource.data.saveRevision + 1;
      allow delete: if false;
    }

    // v110 Server Economy Phase 1. These documents are readable by their owner,
    // but the browser can never create/update/delete them. Only trusted Admin SDK
    // code (Cloud Functions) mutates authoritative economy state and its ledger.
    match /economies/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    match /economyLedger/{uid}/entries/{entryId} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
